#!/bin/bash

echo "🚨 ELIMINANDO .env DE GITHUB - SOLUCIÓN RÁPIDA"
echo "=============================================="
echo ""

# Colores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}📍 Paso 1: Verificando que estamos en un repositorio Git...${NC}"
if [ ! -d .git ]; then
    echo -e "${RED}❌ ERROR: No estás en la raíz de un repositorio Git${NC}"
    echo "   Por favor navega a la carpeta de tu proyecto backend"
    exit 1
fi
echo -e "${GREEN}✅ Repositorio Git encontrado${NC}"
echo ""

echo -e "${YELLOW}📍 Paso 2: Eliminando .env del tracking de Git...${NC}"
if [ -f .env ]; then
    git rm --cached .env 2>/dev/null || echo "   .env no estaba en el index"
    echo -e "${GREEN}✅ .env eliminado del tracking${NC}"
else
    echo -e "${YELLOW}⚠️  Archivo .env no encontrado en el directorio actual${NC}"
fi
echo ""

echo -e "${YELLOW}📍 Paso 3: Creando .gitignore...${NC}"
cat > .gitignore << 'EOF'
# ============================================
# ARCHIVOS SENSIBLES (NUNCA SUBIR A GIT)
# ============================================
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local

# Variables de entorno con credenciales
*.key
*.pem
*.p12
*.pfx
secrets.json
credentials.json

# ============================================
# DEPENDENCIAS
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ============================================
# LOGS
# ============================================
logs/
*.log

# ============================================
# ARCHIVOS DE BUILD
# ============================================
dist/
build/

# ============================================
# EDITORES
# ============================================
.vscode/
.idea/
*.swp
.DS_Store

# ============================================
# TEMPORALES
# ============================================
tmp/
temp/
uploads/
EOF
echo -e "${GREEN}✅ .gitignore creado${NC}"
echo ""

echo -e "${YELLOW}📍 Paso 4: Creando .env.example (plantilla sin credenciales)...${NC}"
cat > .env.example << 'EOF'
# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
PORT=4000

# ============================================
# BASE DE DATOS
# ============================================
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/nombre_bd

# ============================================
# AUTENTICACIÓN JWT
# ============================================
JWT_SECRET=cambia_esto_por_un_secret_seguro
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# ============================================
# EMAIL (Gmail)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password_de_16_caracteres
EMAIL_FROM="Ánima <tu_correo@gmail.com>"

# ============================================
# SPOTIFY API
# ============================================
SPOTIFY_CLIENT_ID=tu_spotify_client_id
SPOTIFY_CLIENT_SECRET=tu_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:4000/auth/spotify/callback

# ============================================
# FRONTEND (CORS)
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# AWS REKOGNITION
# ============================================
AWS_ACCESS_KEY_ID=tu_aws_access_key_id
AWS_SECRET_ACCESS_KEY=tu_aws_secret_access_key
AWS_REGION=us-east-1
EOF
echo -e "${GREEN}✅ .env.example creado${NC}"
echo ""

echo -e "${YELLOW}📍 Paso 5: Agregando archivos a Git...${NC}"
git add .gitignore .env.example
echo -e "${GREEN}✅ Archivos agregados${NC}"
echo ""

echo -e "${YELLOW}📍 Paso 6: Creando commit...${NC}"
git commit -m "Remove .env and add .gitignore"
echo -e "${GREEN}✅ Commit creado${NC}"
echo ""

echo -e "${YELLOW}📍 Paso 7: Subiendo cambios a GitHub...${NC}"
git push
echo -e "${GREEN}✅ Cambios subidos a GitHub${NC}"
echo ""

echo -e "${YELLOW}📍 Paso 8: Verificando que .env ya no está en Git...${NC}"
ENV_CHECK=$(git ls-files | grep "^.env$")
if [ -z "$ENV_CHECK" ]; then
    echo -e "${GREEN}✅✅✅ ¡ÉXITO! .env ya NO está en Git${NC}"
else
    echo -e "${RED}❌ Advertencia: .env todavía aparece en git${NC}"
fi
echo ""

echo "=============================================="
echo -e "${GREEN}🎉 PROCESO COMPLETADO${NC}"
echo "=============================================="
echo ""
echo -e "${YELLOW}⚠️  IMPORTANTE:${NC}"
echo "   El archivo .env ha sido eliminado del tracking de Git,"
echo "   pero AÚN EXISTE en el historial de commits."
echo ""
echo -e "${YELLOW}¿Tu repo es PÚBLICO o PRIVADO?${NC}"
echo ""
echo "   • Si es PRIVADO: Probablemente estás bien"
echo "   • Si es PÚBLICO: Debes limpiar el historial con BFG"
echo ""
echo -e "${GREEN}Próximos pasos:${NC}"
echo "   1. Ve a GitHub y verifica que .env no aparece"
echo "   2. Asegúrate de nunca hacer commit de .env de nuevo"
echo "   3. Si quieres, limpia el historial (pregúntame cómo)"
echo ""