# Puerto del servidor
PORT=4000

# Base de datos
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/miapp

# JWT (autenticación)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# Configuración SMTP para envío de correos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email_here@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM="Nombre <your_email_here@gmail.com>"

# Spotify API
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/auth/spotify/callback

# URL del frontend
FRONTEND_URL=http://localhost:3000

# AWS Rekognition
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
